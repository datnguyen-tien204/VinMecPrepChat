# ═══════════════════════════════════════════════════════════════════════════════
#  VinmecPrep AI — .env.example
#  Copy thành .env rồi điền giá trị thật
#  PowerShell: Copy-Item .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── App / Runtime ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
APP_NAME=VinmecPrep AI
APP_VERSION=2.0.0

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_REPLICAS=2
WORKER_CONCURRENCY=10
CONSUMER_REPLICAS=5
CHAT_POLL_TIMEOUT=45
EMBEDDING_WARMUP=1

# ── LLM (LiteLLM / Groq mặc định) ─────────────────────────────────────────────
LLM_MODEL=groq/qwen/qwen3-32b
LLM_API_BASE=
LLM_API_KEY=replace_with_llm_api_key
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Alias cũ, giữ để tương thích nếu cần
GROQ_API_KEY=replace_with_llm_api_key

# ── Search ────────────────────────────────────────────────────────────────────
SERPER_API_KEY=replace_with_serper_api_key
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET_KEY=replace_with_64_random_chars
WEB_SEARCH_TOP_K=5

# ── Weaviate ──────────────────────────────────────────────────────────────────
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_API_KEY=
WEAVIATE_VECTORIZER=none
WEAVIATE_GRPC_HOST=weaviate
WEAVIATE_GRPC_PORT=50051
WEAVIATE_GRPC_SECURE=false
WEAVIATE_HOST_HTTP_PORT=8079
WEAVIATE_HOST_GRPC_PORT=50061

# Optional nếu chuyển sang Weaviate managed vectorizer
OPENAI_API_KEY=
COHERE_API_KEY=

# ── Embeddings (Jina API) ─────────────────────────────────────────────────────
JINA_API_KEY=replace_with_jina_api_key
JINA_EMBEDDING_ENDPOINT=https://api.jina.ai/v1/embeddings
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
JINA_EMBEDDING_DIMENSIONS=1024
JINA_EMBEDDING_NORMALIZED=true
JINA_EMBEDDING_TASK_QUERY=retrieval.query
JINA_EMBEDDING_TASK_DOCUMENT=retrieval.passage

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace_with_strong_redis_password
REDIS_URL=redis://:replace_with_strong_redis_password@redis:6379/0
REDIS_SESSION_TTL=86400
REDIS_CACHE_TTL=300

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_JOBS=vinmec.chat.jobs
KAFKA_TOPIC_RESULTS=vinmec.chat.results
KAFKA_PARTITIONS=5

# ── Security / Gateway ────────────────────────────────────────────────────────
AGENT_API_KEY=replace_with_long_random_agent_api_key
TRAINER_API_KEY=replace_with_long_random_trainer_api_key
ALLOWED_ORIGINS=https://yourapp.example.com,https://admin.example.com

# ── Limits / Cost Guard ───────────────────────────────────────────────────────
RATE_LIMIT_RPM=10
MAX_INPUT_CHARS=2000
MONTHLY_BUDGET_USD=10.0
PRICE_INPUT_PER_1M_TOKENS_USD=0.27
PRICE_OUTPUT_PER_1M_TOKENS_USD=0.27

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
